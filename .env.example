# Kopieren nach .env und Werte setzen. Die Datei .env NIE ins Repository einchecken.

# Zugang Testsystem (Basic Auth)
COCKPIT_USER=team
# Passwort-Hash erzeugen mit:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'IhrPasswort'
# WICHTIG: Jedes $ im Hash in dieser Datei als $$ schreiben.
COCKPIT_PASS_HASH=

# Datenbank-Passwort (lang und zufällig)
DB_PASSWORD=

# Schlüssel für Sitzungen und die Verschlüsselung der 2FA-Geheimnisse (mind. 32 Zeichen).
# Erzeugen mit:  openssl rand -hex 32
# ACHTUNG: Wird er geändert, sind alle Sitzungen beendet und jeder muss den zweiten Faktor neu einrichten.
SECRET_KEY=

# Zweiter Faktor (Authenticator-App) beim Login.
# false = nur während der Entwicklung: keine 2FA-Einrichtung, keine Code-Abfrage (Basic Auth bleibt aktiv).
# true  = Pflicht für alle Konten. VOR DEM PRODUKTIVSTART ZWINGEND true (CLAUDE.md, „Vor Produktivstart“).
# Fehlt der Eintrag, gilt true.
ZWEI_FAKTOR_PFLICHT=false

# KI-Textvorschläge im Beratungsbericht INIT (Phase 2b). Standard: aus.
# Einschalten (true) erst, wenn kommerzielle API-Bedingungen und AVV (Data Processing Addendum) mit Anthropic vorliegen
# und der Geschäftsführer freigegeben hat. Bis dahin nur Testdaten.
KI_AKTIV=false
# KI_ANBIETER=anthropic          # oder: langdock (noch nicht angebunden)
# KI_MODELL=claude-sonnet-5-5
# CHECKLISTE_MODELL=claude-sonnet-5-5   # „Checkliste einlesen“ (Foto/PDF per KI, gleicher Schalter KI_AKTIV; Word geht ohne KI)
# (Tageslimit der KI-Läufe: je Benutzer in der Oberfläche, Admin → KI-Einstellungen)
# ANTHROPIC_API_KEY=             # Schlüssel nur hier, nie im Repository, nie in Chats

# Wöchentliche Förderprüfung (Phase 2f): KI mit Websuche auf kfw.de, bafa.de, energiewechsel.de, bmwk.de/bmwe.de,
# gesetze-im-internet.de. An die KI gehen nur Förderwerte und Quellen, keine Personen- oder Projektdaten – daher
# unabhängig von KI_AKTIV. Standard: aus; der Geschäftsführer schaltet ein. Braucht ANTHROPIC_API_KEY.
# Zeitplan: Cron als dev, siehe scripts/foerderpruefung.sh (montags 06:10 Uhr Europe/Berlin).
FOERDERPRUEFUNG_AKTIV=false
# Kosten je Lauf (Testlauf 16.11.2026): Vorprüfung Sonnet ≈ 0,21 $, mit gründlicher Prüfung (Opus) ≈ 1,35 $
# FOERDERPRUEFUNG_MODELL=claude-opus-5-5        # gründliche Prüfung (Stufe 2)
# FOERDERPRUEFUNG_VOR_MODELL=claude-sonnet-5-5   # Vorprüfung (Stufe 1)
# FOERDERPRUEFUNG_MAX_SUCHEN=12        # Websuchen der gründlichen Prüfung (10 $ je 1.000 Suchen zzgl. Tokens)
# FOERDERPRUEFUNG_MAX_ABRUFE=5         # Merkblätter/Seiten direkt lesen
# FOERDERPRUEFUNG_VOR_SUCHEN=8         # Websuchen der Vorprüfung (nur Stand-Angaben und Pressemitteilungen)
# FOERDERPRUEFUNG_INTERVALL_TAGE=14    # Zeitplan: Abstand der Läufe (Cron montags, die App überspringt dazwischen)
# FOERDERPRUEFUNG_MAX_LAEUFE_TAG=5     # Kostenbremse für „Jetzt prüfen“ und Zeitplan zusammen

# E-Mail-Benachrichtigungen (Phase 2f): an Konten mit „Erhält Benachrichtigungen Förderkonditionen“.
# Testsystem: Gmail-Testkonto, smtp.gmail.com, Port 587 (STARTTLS), App-Passwort (setzt der Geschäftsführer selbst ein).
# Echtbetrieb später: Firmenpostfach.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORT=
SMTP_ABSENDER=
# SMTP_NUR_PROTOKOLL=true            # Mails nur ins Log (Probebetrieb, Tests)
# Nur Testsystem: alle Mails an diese eine Adresse umleiten, Betreff mit Präfix (Produktion: beide leer lassen)
# SMTP_UMLEITUNG_AN=test@example.org
# SMTP_BETREFF_PRAEFIX=[TEST]
# COCKPIT_URL=https://cockpit.mybase-test.de
