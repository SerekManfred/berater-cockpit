# Kopieren nach .env und Werte setzen. Die Datei .env NIE ins Repository einchecken.

# Zugang Testsystem (Basic Auth)
COCKPIT_USER=team
# Passwort-Hash erzeugen mit:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'IhrPasswort'
# WICHTIG: Jedes $ im Hash in dieser Datei als $$ schreiben.
COCKPIT_PASS_HASH=

# Datenbank-Passwort (lang und zufällig)
DB_PASSWORD=

# Schlüssel für Sitzungen und die Verschlüsselung der 2FA-Geheimnisse (mind. 32 Zeichen).
# Erzeugen mit:  openssl rand -hex 32
# ACHTUNG: Wird er geändert, sind alle Sitzungen beendet und jeder muss den zweiten Faktor neu einrichten.
SECRET_KEY=

# Zweiter Faktor (Authenticator-App) beim Login.
# false = nur während der Entwicklung: keine 2FA-Einrichtung, keine Code-Abfrage (Basic Auth bleibt aktiv).
# true  = Pflicht für alle Konten. VOR DEM PRODUKTIVSTART ZWINGEND true (CLAUDE.md, „Vor Produktivstart“).
# Fehlt der Eintrag, gilt true.
ZWEI_FAKTOR_PFLICHT=false

# KI-Textvorschläge im Beratungsbericht INIT (Phase 2b). Standard: aus.
# Einschalten (true) erst, wenn kommerzielle API-Bedingungen und AVV (Data Processing Addendum) mit Anthropic vorliegen
# und der Geschäftsführer freigegeben hat. Bis dahin nur Testdaten.
KI_AKTIV=false
# KI_ANBIETER=anthropic          # oder: langdock (noch nicht angebunden)
# KI_MODELL=claude-sonnet-5-5
# KI_MAX_LAEUFE_TAG=10           # KI-Läufe je Entwurf und Tag
# ANTHROPIC_API_KEY=             # Schlüssel nur hier, nie im Repository, nie in Chats
