# Interner Webserver des Cockpits (nur HTTP, Port 80 im Container).
# TLS übernimmt der Reverse Proxy des Servers (siehe README, Variante A oder B).
{
	auto_https off
	servers {
		# Vorgeschalteter zentraler Caddy (Docker-Netz): echte Client-IP für das Anmelde-Protokoll übernehmen
		trusted_proxies static private_ranges
	}
}

:80 {
	# Gemeinsamer Zugangsschutz des Testsystems – bleibt zusätzlich zur eigenen Anmeldung
	# bis zum Produktivstart (Reihenfolge siehe CLAUDE.md „Vor Produktivstart“)
	basic_auth {
		{$COCKPIT_USER} {$COCKPIT_PASS_HASH}
	}

	# Gleiche Grenze wie der zentrale Caddy: eine Datei je Anfrage, höchstens 25 MB
	request_body {
		max_size 25MB
	}

	handle_path /api/* {
		reverse_proxy cockpit-api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
